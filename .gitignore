# QuotaDock — Go/Fyne
# 계획서 §23.3 저장소 경계 규칙에 따라 빌드 산출물과 캐시는 커밋하지 않는다.

# 컴파일 산출물
*.exe
*.exe~
*.dll
*.so
*.dylib
*.syso
/quotadock
/quotadock.exe

# 배포 산출물
/dist/
*.msi
*.dmg
*.AppImage
*.app/
SHA256SUMS.txt

# build/ — 릴리스 스크립트는 추적하고 산출물·중간물만 제외한다.
# (Inno Setup 산출물은 OutputDir=..\..\dist 로 나가므로 build/ 안에 남지 않는다)
/build/**/Output/
/build/**/*.exe
/build/**/*.log

# Go 테스트 · 커버리지
*.test
*.out
/coverage/

# Go 워크스페이스 (로컬 전용)
go.work
go.work.sum

# Fyne 패키징 중간물
/fyne-cross/
/.fyne/
*.rc

# 인증 원문 — 절대 커밋 금지 (§12, §23.3)
*.pem
*.key
auth.json
.env
.env.*
!.env.example

# 개발 진행용 내부 문서 — 공개 저장소에 포함하지 않는다.
# 단계별 작업 지시서, 세션 기록, 내부 계획서는 로컬에만 둔다.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.agents/
/docs/PHASE-*.md
/docs/CROSS-REVIEW-*.md
# 단계별 QA 캡처 — README가 참조하는 최상위 4장만 추적한다.
/docs/screenshots/phase*/

# 에디터 · OS · 로컬 도구 설정
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 로컬 도구 캐시
/.tmp/

# Codex 검증용 로컬 빌드 캐시
.cache/
